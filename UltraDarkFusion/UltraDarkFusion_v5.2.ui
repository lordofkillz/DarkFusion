                      <property name="styleSheet">
                       <string notr="true">QPushButton {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgb(59, 61, 62), stop:1 rgb(0, 0, 0));
    color: rgb(238, 238, 238);
	font-size: 8pt;

    border-style: solid;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(0, 0, 0);
    padding: 5px;
}

QPushButton:flat {
    background-color: transparent;
    border: none;
    color: rgb(238, 238, 238);
}

QPushButton:disabled {
    background-color: #404040;
    color: #656565;
    border-color: rgb(0, 0, 0);
}

QPushButton:hover {
    background-color: rgba(236, 157, 0, 51);
    border: 1px solid rgb(236, 157, 0);
}

QPushButton:pressed {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgb(28, 28, 32), stop:1 rgb(0, 0, 0));
    border: 1px solid rgb(236, 157, 0);
}

QPushButton:checked {
    background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0 rgb(28, 28, 32), stop:1 rgb(0, 0, 0));
    border: 1px solid #222;
}</string>
