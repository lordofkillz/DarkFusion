                         <property name="styleSheet">
                          <string notr="true">QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background-color: rgb(0, 0, 0) /*bg_gen*/;
    color: rgb(238, 238, 238) /*txt*/;
    border: 1px solid #000;
    padding: 3px;
    padding-left: 5px;
    border-radius: 2px;
}

QDoubleSpinBox::up-button, QSpinBox::up-button, QDateTimeEdit::up-button {
    border-top-right-radius: 2px;
    background-color: rgb(59, 61, 62) /*bg_alt*/;
    width: 16px;
    border-width: 1px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover, QDateTimeEdit::up-button:hover {
    background-color: orange;
}

QDoubleSpinBox::up-button:pressed, QSpinBox::up-button:pressed, QDateTimeEdit::up-button:pressed {
    background-color: red;
}

QDoubleSpinBox::up-arrow, QSpinBox::up-arrow, QDateTimeEdit::up-arrow {
    image: url(:/16x16/icons/16x16/up.gif);
    width: 7px;
    height: 7px;
}

QDoubleSpinBox::down-button, QSpinBox::down-button, QDateTimeEdit::down-button {
    border-bottom-right-radius: 2px;
    background-color: rgb(59, 61, 62) /*bg_alt*/;
    width: 16px;
    border-width: 1px;
}

QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover, QDateTimeEdit::down-button:hover {
    background-color: orange;
}

QDoubleSpinBox::down-button:pressed, QSpinBox::down-button:pressed, QDateTimeEdit::down-button:pressed {
    background-color: red;
}

QDoubleSpinBox::down-arrow, QSpinBox::down-arrow, QDateTimeEdit::down-arrow {
    image: url(:/16x16/icons/16x16/down.gif);
    width: 7px;
    height: 7px;
}</string>
