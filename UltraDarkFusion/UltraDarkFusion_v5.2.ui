                      <property name="styleSheet">
                       <string notr="true">				QComboBox
				{
					background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0  rgb(59, 61, 62) /*bg_alt*/,stop:1 rgb(28, 28, 32) /*bg_prim*/);
					border: 1px solid #000;
					padding-left: 6px;
					color: rgb(238, 238, 238) /*txt*/;
					height: 20px;
				}
				QComboBox::disabled
				{
					background-color: #404040;
					color: #656565;
					border-color: rgb(0, 0, 0) /*bg_gen*/;
				}
				QComboBox:on
				{
					background-color: rgb(236, 157, 0) /*accent*/;
					color: rgb(28, 28, 28) /*txt_bg*/;
				}
				QComboBox QAbstractItemView
				{
					background-color: rgb(28, 28, 32) /*bg_prim*/;
					color: rgb(238, 238, 238) /*txt*/;
					border: 1px solid black;
					selection-background-color: rgb(236, 157, 0) /*accent*/;
					outline: 0;
				}
				QComboBox::drop-down
				{
					background-color: qlineargradient(spread:repeat, x1:1, y1:0, x2:1, y2:1, stop:0  rgb(0, 0, 0) /*bg_gen*/,stop:1 rgb(28, 28, 32) /*bg_prim*/);
					subcontrol-origin: padding;
					subcontrol-position: top right;
					width: 15px;
					border-left-width: 1px;
					border-left-color: black;
					border-left-style: solid;
				}
				QComboBox::down-arrow
				{
					image: url(:/16x16/icons/16x16/down.gif);
					width: 8px;
					height: 8px;
				}</string>
