                     <property name="styleSheet">
                      <string notr="true">QPushButton {
    background-color: white;
    color: red;
    font-size: 8pt;
    min-width: 53px;
    border-style: solid;
    border-width: 1px;
    border-radius: 4px;
    border-color: rgb(0, 0, 0);
    padding: 5px;
}

QPushButton:hover {
    background-color: red;
    color: white;
}

QPushButton:pressed {
    background-color: red;
    border: 1px solid red;
}</string>
                     </property>
