/* UltraDarkFusion Cadillac theme: professional black, chrome, and restrained burgundy. */
QWidget {
    background-color: #121417;
    color: #e4e7ea;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    selection-background-color: #7b1e2f;
    selection-color: #ffffff;
}

QMainWindow,
QDialog {
    background-color: #0b0d10;
}

QLabel,
QCheckBox,
QRadioButton,
QGroupBox {
    background-color: transparent;
    color: #e4e7ea;
}

QMenuBar,
QMenu,
QToolBar,
QStatusBar,
QDockWidget {
    background-color: #15181d;
    color: #e4e7ea;
    border-color: #343941;
}

QMenuBar::item,
QMenu::item {
    padding: 5px 10px;
    background: transparent;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #7b1e2f;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #20242a;
    padding: 5px;
    font-weight: 600;
}

QFrame,
QGroupBox {
    border: 1px solid #343941;
    border-radius: 6px;
}

QGroupBox {
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QPushButton,
QToolButton {
    background-color: #242930;
    color: #f5f6f7;
    border: 1px solid #4a5058;
    border-radius: 5px;
    padding: 5px 10px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #2c323a;
    border-color: #9f1f2f;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #1a1d22;
    border-color: #c7a66a;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #1a1d22;
    color: #737b86;
    border-color: #2d3239;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #0d0f12;
    color: #f1f3f5;
    border: 1px solid #3d444d;
    border-radius: 5px;
    padding: 4px 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #9f1f2f;
}

QComboBox::drop-down {
    border-left: 1px solid #3d444d;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #0b0d10;
    color: #e4e7ea;
    border: 1px solid #3d444d;
    selection-background-color: #7b1e2f;
}

QTabWidget::pane {
    border: 1px solid #343941;
    background-color: #121417;
}

QTabBar::tab {
    background-color: #1a1d22;
    color: #cfd3d7;
    border: 1px solid #343941;
    padding: 6px 10px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #262c33;
    color: #ffffff;
    border-color: #5a6068;
}

QTabBar::tab:!selected:hover {
    background-color: #252a31;
    color: #ffffff;
}

QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget {
    background-color: #0f1115;
    alternate-background-color: #15181d;
    color: #e4e7ea;
    border: 1px solid #343941;
    gridline-color: #242930;
    selection-background-color: #7b1e2f;
    selection-color: #ffffff;
}

QTableView::item,
QTableWidget::item,
QTreeView::item,
QTreeWidget::item,
QListView::item,
QListWidget::item {
    padding: 4px;
}

QHeaderView::section {
    background-color: #20242a;
    color: #edf2f6;
    border: none;
    border-right: 1px solid #3d444d;
    border-bottom: 1px solid #3d444d;
    padding: 5px;
    font-weight: 600;
}

QProgressBar {
    background-color: #0f1115;
    color: #edf2f6;
    border: 1px solid #343941;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #7b1e2f;
    border-radius: 4px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #343941;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #9f1f2f;
    border: 1px solid #c7a66a;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #0b0d10;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #4a5058;
    border-radius: 6px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #5b626b;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QCheckBox#zoom_lock,
QCheckBox#image_quality_checkbox,
QCheckBox#outline_Checkbox,
QCheckBox#rapid_del_checkbox,
QCheckBox#auto_scan_checkbox,
QCheckBox#voice_mode_checkbox {
    background-color: #20242a;
    color: #e4e7ea;
    border: 1px solid #4a5058;
    border-radius: 5px;
    padding: 4px 10px;
    spacing: 0;
}

QCheckBox#zoom_lock:hover,
QCheckBox#image_quality_checkbox:hover,
QCheckBox#outline_Checkbox:hover,
QCheckBox#rapid_del_checkbox:hover,
QCheckBox#auto_scan_checkbox:hover,
QCheckBox#voice_mode_checkbox:hover {
    background-color: #2c323a;
    border-color: #9f1f2f;
}

QCheckBox#zoom_lock:checked,
QCheckBox#image_quality_checkbox:checked,
QCheckBox#outline_Checkbox:checked,
QCheckBox#rapid_del_checkbox:checked,
QCheckBox#auto_scan_checkbox:checked,
QCheckBox#voice_mode_checkbox:checked {
    background-color: #642130;
    color: #ffffff;
    border-color: #b99058;
}

QCheckBox#zoom_lock:checked:hover,
QCheckBox#image_quality_checkbox:checked:hover,
QCheckBox#outline_Checkbox:checked:hover,
QCheckBox#rapid_del_checkbox:checked:hover,
QCheckBox#auto_scan_checkbox:checked:hover,
QCheckBox#voice_mode_checkbox:checked:hover {
    background-color: #7b1e2f;
    border-color: #c7a66a;
}

QCheckBox#zoom_lock::indicator,
QCheckBox#image_quality_checkbox::indicator,
QCheckBox#outline_Checkbox::indicator,
QCheckBox#rapid_del_checkbox::indicator,
QCheckBox#auto_scan_checkbox::indicator,
QCheckBox#voice_mode_checkbox::indicator {
    width: 0;
    height: 0;
    margin: 0;
}


/* Cadillac-specific premium accents */
QPushButton:default {
    border-color: #b99058;
}

QPushButton#cuda_monitor_button {
    background-color: #1b2027;
    border-color: #5a6068;
    color: #f5f6f7;
    font-weight: 700;
}

QCheckBox#zoom_lock,
QCheckBox#image_quality_checkbox,
QCheckBox#outline_Checkbox,
QCheckBox#rapid_del_checkbox,
QCheckBox#auto_scan_checkbox,
QCheckBox#voice_mode_checkbox,
QCheckBox#auto_class {
    background-color: #20242a;
    color: #e4e7ea;
    border: 1px solid #4a5058;
    border-radius: 5px;
    padding: 4px 10px;
    spacing: 0;
}

QCheckBox#zoom_lock:hover,
QCheckBox#image_quality_checkbox:hover,
QCheckBox#outline_Checkbox:hover,
QCheckBox#rapid_del_checkbox:hover,
QCheckBox#auto_scan_checkbox:hover,
QCheckBox#voice_mode_checkbox:hover,
QCheckBox#auto_class:hover {
    background-color: #2c323a;
    border-color: #b99058;
}

QCheckBox#zoom_lock:checked,
QCheckBox#image_quality_checkbox:checked,
QCheckBox#outline_Checkbox:checked,
QCheckBox#rapid_del_checkbox:checked,
QCheckBox#auto_scan_checkbox:checked,
QCheckBox#voice_mode_checkbox:checked,
QCheckBox#auto_class:checked {
    background-color: #642130;
    color: #ffffff;
    border-color: #b99058;
}

QCheckBox#zoom_lock::indicator,
QCheckBox#image_quality_checkbox::indicator,
QCheckBox#outline_Checkbox::indicator,
QCheckBox#rapid_del_checkbox::indicator,
QCheckBox#auto_scan_checkbox::indicator,
QCheckBox#voice_mode_checkbox::indicator,
QCheckBox#auto_class::indicator {
    width: 0;
    height: 0;
    margin: 0;
}
