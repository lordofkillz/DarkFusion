/* Star Trek: blue panels with amber command accents. */
QWidget {
    background-color: #121923;
    color: #dde7f0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    selection-background-color: #226b9a;
    selection-color: #ffffff;
}

QMainWindow,
QDialog {
    background-color: #0d131b;
}

QLabel,
QCheckBox,
QRadioButton,
QGroupBox {
    background-color: transparent;
    color: #dde7f0;
}

QMenuBar,
QMenu,
QToolBar,
QStatusBar,
QDockWidget {
    background-color: #16202b;
    color: #dde7f0;
    border-color: #2b3b4a;
}

QMenuBar::item,
QMenu::item {
    padding: 5px 10px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #226b9a;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #1f2b38;
    padding: 5px;
    font-weight: 600;
}

QFrame,
QGroupBox {
    background-color: #161f2a;
    border: 1px solid #2b3b4a;
    border-radius: 6px;
}

QGroupBox {
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QPushButton,
QToolButton {
    background-color: #223041;
    color: #f4f8fb;
    border: 1px solid #3c5063;
    border-radius: 5px;
    padding: 5px 10px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #293a4f;
    border-color: #f0a22a;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #1a2633;
    border-color: #d64a3a;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #1a222c;
    color: #788796;
    border-color: #293541;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #0d131b;
    color: #f4f8fb;
    border: 1px solid #334656;
    border-radius: 5px;
    padding: 4px 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #f0a22a;
}

QComboBox::drop-down {
    border-left: 1px solid #334656;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #121923;
    color: #dde7f0;
    border: 1px solid #334656;
    selection-background-color: #226b9a;
}

QTabWidget::pane {
    border: 1px solid #2b3b4a;
    background-color: #121923;
}

QTabBar::tab {
    background-color: #1b2734;
    color: #c7d3df;
    border: 1px solid #2b3b4a;
    padding: 6px 10px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #243b50;
    color: #ffffff;
    border-color: #42627b;
}

QTabBar::tab:!selected:hover {
    background-color: #223041;
    color: #ffffff;
}

QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget {
    background-color: #0d131b;
    alternate-background-color: #141d27;
    color: #dde7f0;
    border: 1px solid #2b3b4a;
    gridline-color: #223041;
    selection-background-color: #226b9a;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #1f2b38;
    color: #f4f8fb;
    border: none;
    border-right: 1px solid #314153;
    border-bottom: 1px solid #314153;
    padding: 5px;
    font-weight: 600;
}

QProgressBar {
    background-color: #0d131b;
    color: #f4f8fb;
    border: 1px solid #2b3b4a;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #f0a22a;
    border-radius: 4px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #2b3b4a;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #f0a22a;
    border: 1px solid #ffd37a;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #0d131b;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #3c5063;
    border-radius: 6px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #226b9a;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}
/* DarkFusion quick toggle buttons: compact inactive state, red active state. */
QCheckBox#zoom_lock,
QCheckBox#image_quality_checkbox,
QCheckBox#outline_Checkbox,
QCheckBox#rapid_del_checkbox,
QCheckBox#auto_scan_checkbox,
QCheckBox#voice_mode_checkbox {
    background-color: rgba(32, 36, 42, 190);
    color: #f2f5f8;
    border: 1px solid #3a424d;
    border-radius: 5px;
    padding: 4px 10px;
    spacing: 0;
}

QCheckBox#zoom_lock:hover,
QCheckBox#image_quality_checkbox:hover,
QCheckBox#outline_Checkbox:hover,
QCheckBox#rapid_del_checkbox:hover,
QCheckBox#auto_scan_checkbox:hover,
QCheckBox#voice_mode_checkbox:hover {
    background-color: rgba(45, 53, 64, 210);
    border-color: #ff7377;
}

QCheckBox#zoom_lock:checked,
QCheckBox#image_quality_checkbox:checked,
QCheckBox#outline_Checkbox:checked,
QCheckBox#rapid_del_checkbox:checked,
QCheckBox#auto_scan_checkbox:checked,
QCheckBox#voice_mode_checkbox:checked {
    background-color: #8f272b;
    color: #ffffff;
    border-color: #ff5a5f;
}

QCheckBox#zoom_lock:checked:hover,
QCheckBox#image_quality_checkbox:checked:hover,
QCheckBox#outline_Checkbox:checked:hover,
QCheckBox#rapid_del_checkbox:checked:hover,
QCheckBox#auto_scan_checkbox:checked:hover,
QCheckBox#voice_mode_checkbox:checked:hover {
    background-color: #a83236;
    border-color: #ff7377;
}

QCheckBox#zoom_lock::indicator,
QCheckBox#image_quality_checkbox::indicator,
QCheckBox#outline_Checkbox::indicator,
QCheckBox#rapid_del_checkbox::indicator,
QCheckBox#auto_scan_checkbox::indicator,
QCheckBox#voice_mode_checkbox::indicator {
    width: 0;
    height: 0;
    margin: 0;
}
