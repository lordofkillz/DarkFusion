/* DarkFusion / Dragonfire. Separate, scalable assets. Generated from themes.json. */
QWidget {background-color:#100D0B;color:#F6EEE4;font-family:"Segoe UI";font-size:10pt;selection-background-color:#70442B;selection-color:#F6EEE4;}
QMainWindow,QDialog {background-color:#100D0B;}
QLabel,QCheckBox,QRadioButton {background:transparent;border:none;}
QFrame {border:none;}
QMenuBar,QMenu,QToolBar,QStatusBar {background:#211915;color:#F6EEE4;border:1px solid #665042;}
QMenuBar::item {background:transparent;padding:5px 9px;}
QMenuBar::item:selected,QMenu::item:selected {background:#503221;color:#F49A58;}
QMenu::item {padding:6px 26px 6px 22px;}
QMenu::separator {height:1px;background:#665042;margin:4px 12px;}
QDockWidget {color:#F6EEE4;titlebar-close-icon:url(styles/df-assets/dragonfire/icons/close.svg);}
QDockWidget::title {background:#211915;color:#F49A58;padding:5px 9px;border-bottom:1px solid #665042;font-weight:600;}
QGroupBox {background:#211915;border:1px solid #665042;border-radius:4px;margin-top:12px;padding:12px 8px 8px;}
QGroupBox::title {subcontrol-origin:margin;subcontrol-position:top left;left:12px;padding:0px 5px;color:#F49A58;background:#100D0B;}
QPushButton,QToolButton {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #30221B,stop:1 #211915);border:1px solid #665042;border-radius:2px;color:#F6EEE4;padding:4px 8px;}
QPushButton:hover,QToolButton:hover {background:#503221;border-color:#F49A58;}
QPushButton:pressed,QToolButton:pressed,QPushButton:checked,QToolButton:checked {background:#70442B;border-color:#F49A58;color:#F6EEE4;}
QPushButton:focus,QToolButton:focus {border:1px solid #F49A58;background:#503221;}
QPushButton:disabled,QToolButton:disabled {background:#100D0B;color:#BBA696;border-color:#211915;}
QPushButton#extract_button,QPushButton#download_video,QPushButton#video_upload {border-color:#F49A58;font-weight:600;}
QLineEdit,QTextEdit,QPlainTextEdit,QSpinBox,QDoubleSpinBox,QComboBox {background:#100D0B;color:#F6EEE4;border:1px solid #665042;border-radius:2px;padding:4px 6px;}
QLineEdit:focus,QTextEdit:focus,QPlainTextEdit:focus,QSpinBox:focus,QDoubleSpinBox:focus,QComboBox:focus {border-color:#F49A58;}
QComboBox::drop-down {width:20px;border:none;}
QComboBox::down-arrow {image:url(styles/df-assets/dragonfire/icons/chevron-down.svg);width:12px;height:12px;}
QSpinBox::up-arrow,QDoubleSpinBox::up-arrow {image:url(styles/df-assets/dragonfire/icons/chevron-up.svg);width:9px;height:9px;}
QSpinBox::down-arrow,QDoubleSpinBox::down-arrow {image:url(styles/df-assets/dragonfire/icons/chevron-down.svg);width:9px;height:9px;}
QComboBox QAbstractItemView {background:#211915;color:#F6EEE4;selection-background-color:#70442B;border:1px solid #F49A58;}
QTabWidget::pane {border:1px solid #665042;background:#100D0B;}
QTabBar::tab {background:#211915;color:#BBA696;border:1px solid #665042;padding:6px 9px;margin-right:2px;}
QTabBar::tab:selected {background:#30221B;color:#F49A58;border-bottom:2px solid #F49A58;}
QTabBar::tab:hover {background:#503221;color:#F6EEE4;}
QTableView,QTreeView,QListView,QTableWidget,QTreeWidget,QListWidget {background:#100D0B;alternate-background-color:#211915;color:#F6EEE4;border:1px solid #665042;gridline-color:#665042;selection-background-color:#70442B;selection-color:#F6EEE4;}
QAbstractItemView::item:hover {background:#503221;}
QAbstractItemView::item:selected {background:#70442B;color:#F6EEE4;}
QHeaderView::section {background:#30221B;color:#F6EEE4;padding:5px;border:none;border-bottom:1px solid #665042;font-weight:600;}
QTableCornerButton::section {background:#30221B;border:1px solid #665042;}
QProgressBar {background:#100D0B;border:1px solid #665042;border-radius:4px;text-align:center;color:#F6EEE4;min-height:12px;}
QProgressBar::chunk {background:#70442B;border-radius:3px;}
QSlider::groove:horizontal {background:#30221B;height:6px;border-radius:3px;}
QSlider::sub-page:horizontal {background:#70442B;border-radius:3px;}
QSlider::handle:horizontal {background:#F49A58;width:14px;margin:-4px 0;border-radius:7px;border:1px solid #E8BC76;}
QScrollBar:vertical {background:#100D0B;width:10px;margin:0;}
QScrollBar:horizontal {background:#100D0B;height:10px;margin:0;}
QScrollBar::handle {background:#665042;border-radius:4px;min-width:20px;min-height:20px;}
QScrollBar::handle:hover {background:#F49A58;}
QScrollBar::add-line,QScrollBar::sub-line {height:0;width:0;}
QScrollBar::add-page,QScrollBar::sub-page {background:transparent;}
QCheckBox::indicator,QGroupBox::indicator {width:14px;height:14px;border:1px solid #665042;border-radius:3px;background:#100D0B;}
QCheckBox::indicator:checked,QGroupBox::indicator:checked {background:#70442B;border-color:#F49A58;image:url(styles/df-assets/dragonfire/icons/check.svg);}
QCheckBox::indicator:hover {border-color:#F49A58;}
QRadioButton::indicator {width:14px;height:14px;border:1px solid #665042;border-radius:7px;background:#100D0B;}
QRadioButton::indicator:checked {border:4px solid #F49A58;background:#100D0B;}
QToolTip {background:#30221B;color:#F6EEE4;border:1px solid #F49A58;padding:5px;}
QSplitter::handle {background:#211915;}
QSplitter::handle:hover {background:#665042;}
QLabel#image_label_2 {background:#100D0B;border:1px solid #665042;border-radius:4px;}
QCheckBox#zoom_lock,QCheckBox#image_quality_checkbox,QCheckBox#outline_Checkbox,QCheckBox#rapid_del_checkbox,QCheckBox#auto_scan_checkbox,QCheckBox#voice_mode_checkbox {padding:4px 8px;background:#30221B;border:1px solid #665042;border-radius:2px;}
QCheckBox#zoom_lock:checked,QCheckBox#image_quality_checkbox:checked,QCheckBox#outline_Checkbox:checked,QCheckBox#rapid_del_checkbox:checked,QCheckBox#auto_scan_checkbox:checked,QCheckBox#voice_mode_checkbox:checked {background:#70442B;border-color:#F49A58;}
QCheckBox#zoom_lock::indicator,QCheckBox#image_quality_checkbox::indicator,QCheckBox#outline_Checkbox::indicator,QCheckBox#rapid_del_checkbox::indicator,QCheckBox#auto_scan_checkbox::indicator,QCheckBox#voice_mode_checkbox::indicator {width:0;height:0;border:none;}
QWidget#dockWidgetContents_3,QFrame#frame_27 {background:transparent;}
QWidget[dfHeaderPanel="true"] {background:transparent;border:none;}
QPushButton#video_upload,QPushButton#download_video,QPushButton#remove_video_button {border:8px solid transparent;border-image:url(styles/df-assets/dragonfire/buttons/background-normal.png) 16 16 16 16 stretch stretch;padding:0px 4px;}
QPushButton#video_upload:hover,QPushButton#download_video:hover,QPushButton#remove_video_button:hover {border-image:url(styles/df-assets/dragonfire/buttons/background-hover.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:pressed,QPushButton#download_video:pressed,QPushButton#remove_video_button:pressed {border-image:url(styles/df-assets/dragonfire/buttons/background-pressed.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:disabled,QPushButton#download_video:disabled,QPushButton#remove_video_button:disabled {border-image:url(styles/df-assets/dragonfire/buttons/background-disabled.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:focus,QPushButton#download_video:focus,QPushButton#remove_video_button:focus {border-image:url(styles/df-assets/dragonfire/buttons/background-focus.png) 16 16 16 16 stretch stretch;}
/* FULL-WIDTH TOP BARS v2 */
QMenuBar {border-image:url(styles/df-assets/dragonfire/menu-bar.png) 0 0 0 0 stretch stretch;border-bottom:1px solid #665042;}
QDockWidget::title {border-image:url(styles/df-assets/dragonfire/status-bar.png) 0 0 0 0 stretch stretch;}
