/* DarkFusion / Eclipse Knight. Separate, scalable assets. Generated from themes.json. */
QWidget {background-color:#0B0910;color:#F0EAF8;font-family:"Segoe UI";font-size:10pt;selection-background-color:#51406C;selection-color:#F0EAF8;}
QMainWindow,QDialog {background-color:#0B0910;}
QLabel,QCheckBox,QRadioButton {background:transparent;border:none;}
QFrame {border:none;}
QMenuBar,QMenu,QToolBar,QStatusBar {background:#171220;color:#F0EAF8;border:1px solid #51445F;}
QMenuBar::item {background:transparent;padding:5px 9px;}
QMenuBar::item:selected,QMenu::item:selected {background:#392C4E;color:#B497F5;}
QMenu::item {padding:6px 26px 6px 22px;}
QMenu::separator {height:1px;background:#51445F;margin:4px 12px;}
QDockWidget {color:#F0EAF8;titlebar-close-icon:url(styles/df-assets/eclipse-knight/icons/close.svg);}
QDockWidget::title {background:#171220;color:#B497F5;padding:5px 9px;border-bottom:1px solid #51445F;font-weight:600;}
QGroupBox {background:#171220;border:1px solid #51445F;border-radius:5px;margin-top:12px;padding:12px 8px 8px;}
QGroupBox::title {subcontrol-origin:margin;subcontrol-position:top left;left:12px;padding:0px 5px;color:#B497F5;background:#0B0910;}
QPushButton,QToolButton {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #241C31,stop:1 #171220);border:1px solid #51445F;border-radius:3px;color:#F0EAF8;padding:4px 8px;}
QPushButton:hover,QToolButton:hover {background:#392C4E;border-color:#B497F5;}
QPushButton:pressed,QToolButton:pressed,QPushButton:checked,QToolButton:checked {background:#51406C;border-color:#B497F5;color:#F0EAF8;}
QPushButton:focus,QToolButton:focus {border:1px solid #B497F5;background:#392C4E;}
QPushButton:disabled,QToolButton:disabled {background:#0B0910;color:#ADA1BB;border-color:#171220;}
QPushButton#extract_button,QPushButton#download_video,QPushButton#video_upload {border-color:#B497F5;font-weight:600;}
QLineEdit,QTextEdit,QPlainTextEdit,QSpinBox,QDoubleSpinBox,QComboBox {background:#0B0910;color:#F0EAF8;border:1px solid #51445F;border-radius:3px;padding:4px 6px;}
QLineEdit:focus,QTextEdit:focus,QPlainTextEdit:focus,QSpinBox:focus,QDoubleSpinBox:focus,QComboBox:focus {border-color:#B497F5;}
QComboBox::drop-down {width:20px;border:none;}
QComboBox::down-arrow {image:url(styles/df-assets/eclipse-knight/icons/chevron-down.svg);width:12px;height:12px;}
QSpinBox::up-arrow,QDoubleSpinBox::up-arrow {image:url(styles/df-assets/eclipse-knight/icons/chevron-up.svg);width:9px;height:9px;}
QSpinBox::down-arrow,QDoubleSpinBox::down-arrow {image:url(styles/df-assets/eclipse-knight/icons/chevron-down.svg);width:9px;height:9px;}
QComboBox QAbstractItemView {background:#171220;color:#F0EAF8;selection-background-color:#51406C;border:1px solid #B497F5;}
QTabWidget::pane {border:1px solid #51445F;background:#0B0910;}
QTabBar::tab {background:#171220;color:#ADA1BB;border:1px solid #51445F;padding:6px 9px;margin-right:2px;}
QTabBar::tab:selected {background:#241C31;color:#B497F5;border-bottom:2px solid #B497F5;}
QTabBar::tab:hover {background:#392C4E;color:#F0EAF8;}
QTableView,QTreeView,QListView,QTableWidget,QTreeWidget,QListWidget {background:#0B0910;alternate-background-color:#171220;color:#F0EAF8;border:1px solid #51445F;gridline-color:#51445F;selection-background-color:#51406C;selection-color:#F0EAF8;}
QAbstractItemView::item:hover {background:#392C4E;}
QAbstractItemView::item:selected {background:#51406C;color:#F0EAF8;}
QHeaderView::section {background:#241C31;color:#F0EAF8;padding:5px;border:none;border-bottom:1px solid #51445F;font-weight:600;}
QTableCornerButton::section {background:#241C31;border:1px solid #51445F;}
QProgressBar {background:#0B0910;border:1px solid #51445F;border-radius:4px;text-align:center;color:#F0EAF8;min-height:12px;}
QProgressBar::chunk {background:#51406C;border-radius:3px;}
QSlider::groove:horizontal {background:#241C31;height:6px;border-radius:3px;}
QSlider::sub-page:horizontal {background:#51406C;border-radius:3px;}
QSlider::handle:horizontal {background:#B497F5;width:14px;margin:-4px 0;border-radius:7px;border:1px solid #C8CEDA;}
QScrollBar:vertical {background:#0B0910;width:10px;margin:0;}
QScrollBar:horizontal {background:#0B0910;height:10px;margin:0;}
QScrollBar::handle {background:#51445F;border-radius:4px;min-width:20px;min-height:20px;}
QScrollBar::handle:hover {background:#B497F5;}
QScrollBar::add-line,QScrollBar::sub-line {height:0;width:0;}
QScrollBar::add-page,QScrollBar::sub-page {background:transparent;}
QCheckBox::indicator,QGroupBox::indicator {width:14px;height:14px;border:1px solid #51445F;border-radius:3px;background:#0B0910;}
QCheckBox::indicator:checked,QGroupBox::indicator:checked {background:#51406C;border-color:#B497F5;image:url(styles/df-assets/eclipse-knight/icons/check.svg);}
QCheckBox::indicator:hover {border-color:#B497F5;}
QRadioButton::indicator {width:14px;height:14px;border:1px solid #51445F;border-radius:7px;background:#0B0910;}
QRadioButton::indicator:checked {border:4px solid #B497F5;background:#0B0910;}
QToolTip {background:#241C31;color:#F0EAF8;border:1px solid #B497F5;padding:5px;}
QSplitter::handle {background:#171220;}
QSplitter::handle:hover {background:#51445F;}
QLabel#image_label_2 {background:#0B0910;border:1px solid #51445F;border-radius:5px;}
QCheckBox#zoom_lock,QCheckBox#image_quality_checkbox,QCheckBox#outline_Checkbox,QCheckBox#rapid_del_checkbox,QCheckBox#auto_scan_checkbox,QCheckBox#voice_mode_checkbox {padding:4px 8px;background:#241C31;border:1px solid #51445F;border-radius:3px;}
QCheckBox#zoom_lock:checked,QCheckBox#image_quality_checkbox:checked,QCheckBox#outline_Checkbox:checked,QCheckBox#rapid_del_checkbox:checked,QCheckBox#auto_scan_checkbox:checked,QCheckBox#voice_mode_checkbox:checked {background:#51406C;border-color:#B497F5;}
QCheckBox#zoom_lock::indicator,QCheckBox#image_quality_checkbox::indicator,QCheckBox#outline_Checkbox::indicator,QCheckBox#rapid_del_checkbox::indicator,QCheckBox#auto_scan_checkbox::indicator,QCheckBox#voice_mode_checkbox::indicator {width:0;height:0;border:none;}
QWidget#dockWidgetContents_3,QFrame#frame_27 {background:transparent;}
QWidget[dfHeaderPanel="true"] {background:transparent;border:none;}
QPushButton#video_upload,QPushButton#download_video,QPushButton#remove_video_button {border:8px solid transparent;border-image:url(styles/df-assets/eclipse-knight/buttons/background-normal.png) 16 16 16 16 stretch stretch;padding:0px 4px;}
QPushButton#video_upload:hover,QPushButton#download_video:hover,QPushButton#remove_video_button:hover {border-image:url(styles/df-assets/eclipse-knight/buttons/background-hover.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:pressed,QPushButton#download_video:pressed,QPushButton#remove_video_button:pressed {border-image:url(styles/df-assets/eclipse-knight/buttons/background-pressed.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:disabled,QPushButton#download_video:disabled,QPushButton#remove_video_button:disabled {border-image:url(styles/df-assets/eclipse-knight/buttons/background-disabled.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:focus,QPushButton#download_video:focus,QPushButton#remove_video_button:focus {border-image:url(styles/df-assets/eclipse-knight/buttons/background-focus.png) 16 16 16 16 stretch stretch;}
/* FULL-WIDTH TOP BARS v2 */
QMenuBar {border-image:url(styles/df-assets/eclipse-knight/menu-bar.png) 0 0 0 0 stretch stretch;border-bottom:1px solid #51445F;}
QDockWidget::title {border-image:url(styles/df-assets/eclipse-knight/status-bar.png) 0 0 0 0 stretch stretch;}
