/* DarkFusion / Crimson Eye. Separate, scalable assets. Generated from themes.json. */
QWidget {background-color:#0E0B0E;color:#F7EAF0;font-family:"Segoe UI";font-size:10pt;selection-background-color:#713246;selection-color:#F7EAF0;}
QMainWindow,QDialog {background-color:#0E0B0E;}
QLabel,QCheckBox,QRadioButton {background:transparent;border:none;}
QFrame {border:none;}
QMenuBar,QMenu,QToolBar,QStatusBar {background:#20151D;color:#F7EAF0;border:1px solid #654553;}
QMenuBar::item {background:transparent;padding:5px 9px;}
QMenuBar::item:selected,QMenu::item:selected {background:#4D293A;color:#EF7489;}
QMenu::item {padding:6px 26px 6px 22px;}
QMenu::separator {height:1px;background:#654553;margin:4px 12px;}
QDockWidget {color:#F7EAF0;titlebar-close-icon:url(styles/df-assets/crimson-eye/icons/close.svg);}
QDockWidget::title {background:#20151D;color:#EF7489;padding:5px 9px;border-bottom:1px solid #654553;font-weight:600;}
QGroupBox {background:#20151D;border:1px solid #654553;border-radius:7px;margin-top:12px;padding:12px 8px 8px;}
QGroupBox::title {subcontrol-origin:margin;subcontrol-position:top left;left:12px;padding:0px 5px;color:#EF7489;background:#0E0B0E;}
QPushButton,QToolButton {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #30202C,stop:1 #20151D);border:1px solid #654553;border-radius:5px;color:#F7EAF0;padding:4px 8px;}
QPushButton:hover,QToolButton:hover {background:#4D293A;border-color:#EF7489;}
QPushButton:pressed,QToolButton:pressed,QPushButton:checked,QToolButton:checked {background:#713246;border-color:#EF7489;color:#F7EAF0;}
QPushButton:focus,QToolButton:focus {border:1px solid #EF7489;background:#4D293A;}
QPushButton:disabled,QToolButton:disabled {background:#0E0B0E;color:#BBA2AE;border-color:#20151D;}
QPushButton#extract_button,QPushButton#download_video,QPushButton#video_upload {border-color:#EF7489;font-weight:600;}
QLineEdit,QTextEdit,QPlainTextEdit,QSpinBox,QDoubleSpinBox,QComboBox {background:#0E0B0E;color:#F7EAF0;border:1px solid #654553;border-radius:5px;padding:4px 6px;}
QLineEdit:focus,QTextEdit:focus,QPlainTextEdit:focus,QSpinBox:focus,QDoubleSpinBox:focus,QComboBox:focus {border-color:#EF7489;}
QComboBox::drop-down {width:20px;border:none;}
QComboBox::down-arrow {image:url(styles/df-assets/crimson-eye/icons/chevron-down.svg);width:12px;height:12px;}
QSpinBox::up-arrow,QDoubleSpinBox::up-arrow {image:url(styles/df-assets/crimson-eye/icons/chevron-up.svg);width:9px;height:9px;}
QSpinBox::down-arrow,QDoubleSpinBox::down-arrow {image:url(styles/df-assets/crimson-eye/icons/chevron-down.svg);width:9px;height:9px;}
QComboBox QAbstractItemView {background:#20151D;color:#F7EAF0;selection-background-color:#713246;border:1px solid #EF7489;}
QTabWidget::pane {border:1px solid #654553;background:#0E0B0E;}
QTabBar::tab {background:#20151D;color:#BBA2AE;border:1px solid #654553;padding:6px 9px;margin-right:2px;}
QTabBar::tab:selected {background:#30202C;color:#EF7489;border-bottom:2px solid #EF7489;}
QTabBar::tab:hover {background:#4D293A;color:#F7EAF0;}
QTableView,QTreeView,QListView,QTableWidget,QTreeWidget,QListWidget {background:#0E0B0E;alternate-background-color:#20151D;color:#F7EAF0;border:1px solid #654553;gridline-color:#654553;selection-background-color:#713246;selection-color:#F7EAF0;}
QAbstractItemView::item:hover {background:#4D293A;}
QAbstractItemView::item:selected {background:#713246;color:#F7EAF0;}
QHeaderView::section {background:#30202C;color:#F7EAF0;padding:5px;border:none;border-bottom:1px solid #654553;font-weight:600;}
QTableCornerButton::section {background:#30202C;border:1px solid #654553;}
QProgressBar {background:#0E0B0E;border:1px solid #654553;border-radius:4px;text-align:center;color:#F7EAF0;min-height:12px;}
QProgressBar::chunk {background:#713246;border-radius:3px;}
QSlider::groove:horizontal {background:#30202C;height:6px;border-radius:3px;}
QSlider::sub-page:horizontal {background:#713246;border-radius:3px;}
QSlider::handle:horizontal {background:#EF7489;width:14px;margin:-4px 0;border-radius:7px;border:1px solid #D5D1DA;}
QScrollBar:vertical {background:#0E0B0E;width:10px;margin:0;}
QScrollBar:horizontal {background:#0E0B0E;height:10px;margin:0;}
QScrollBar::handle {background:#654553;border-radius:4px;min-width:20px;min-height:20px;}
QScrollBar::handle:hover {background:#EF7489;}
QScrollBar::add-line,QScrollBar::sub-line {height:0;width:0;}
QScrollBar::add-page,QScrollBar::sub-page {background:transparent;}
QCheckBox::indicator,QGroupBox::indicator {width:14px;height:14px;border:1px solid #654553;border-radius:3px;background:#0E0B0E;}
QCheckBox::indicator:checked,QGroupBox::indicator:checked {background:#713246;border-color:#EF7489;image:url(styles/df-assets/crimson-eye/icons/check.svg);}
QCheckBox::indicator:hover {border-color:#EF7489;}
QRadioButton::indicator {width:14px;height:14px;border:1px solid #654553;border-radius:7px;background:#0E0B0E;}
QRadioButton::indicator:checked {border:4px solid #EF7489;background:#0E0B0E;}
QToolTip {background:#30202C;color:#F7EAF0;border:1px solid #EF7489;padding:5px;}
QSplitter::handle {background:#20151D;}
QSplitter::handle:hover {background:#654553;}
QLabel#image_label_2 {background:#0E0B0E;border:1px solid #654553;border-radius:7px;}
QCheckBox#zoom_lock,QCheckBox#image_quality_checkbox,QCheckBox#outline_Checkbox,QCheckBox#rapid_del_checkbox,QCheckBox#auto_scan_checkbox,QCheckBox#voice_mode_checkbox {padding:4px 8px;background:#30202C;border:1px solid #654553;border-radius:5px;}
QCheckBox#zoom_lock:checked,QCheckBox#image_quality_checkbox:checked,QCheckBox#outline_Checkbox:checked,QCheckBox#rapid_del_checkbox:checked,QCheckBox#auto_scan_checkbox:checked,QCheckBox#voice_mode_checkbox:checked {background:#713246;border-color:#EF7489;}
QCheckBox#zoom_lock::indicator,QCheckBox#image_quality_checkbox::indicator,QCheckBox#outline_Checkbox::indicator,QCheckBox#rapid_del_checkbox::indicator,QCheckBox#auto_scan_checkbox::indicator,QCheckBox#voice_mode_checkbox::indicator {width:0;height:0;border:none;}
QWidget#dockWidgetContents_3,QFrame#frame_27 {background:transparent;}
QWidget[dfHeaderPanel="true"] {background:transparent;border:none;}
QPushButton#video_upload,QPushButton#download_video,QPushButton#remove_video_button {border:8px solid transparent;border-image:url(styles/df-assets/crimson-eye/buttons/background-normal.png) 16 16 16 16 stretch stretch;padding:0px 4px;}
QPushButton#video_upload:hover,QPushButton#download_video:hover,QPushButton#remove_video_button:hover {border-image:url(styles/df-assets/crimson-eye/buttons/background-hover.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:pressed,QPushButton#download_video:pressed,QPushButton#remove_video_button:pressed {border-image:url(styles/df-assets/crimson-eye/buttons/background-pressed.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:disabled,QPushButton#download_video:disabled,QPushButton#remove_video_button:disabled {border-image:url(styles/df-assets/crimson-eye/buttons/background-disabled.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:focus,QPushButton#download_video:focus,QPushButton#remove_video_button:focus {border-image:url(styles/df-assets/crimson-eye/buttons/background-focus.png) 16 16 16 16 stretch stretch;}
/* FULL-WIDTH TOP BARS v2 */
QMenuBar {border-image:url(styles/df-assets/crimson-eye/menu-bar.png) 0 0 0 0 stretch stretch;border-bottom:1px solid #654553;}
QDockWidget::title {border-image:url(styles/df-assets/crimson-eye/status-bar.png) 0 0 0 0 stretch stretch;}
