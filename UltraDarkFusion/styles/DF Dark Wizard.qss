/* DarkFusion / Dark Wizard. Separate, scalable assets. Generated from themes.json. */
QWidget {background-color:#080F12;color:#E5EEE9;font-family:"Segoe UI";font-size:10pt;selection-background-color:#29675E;selection-color:#E5EEE9;}
QMainWindow,QDialog {background-color:#080F12;}
QLabel,QCheckBox,QRadioButton {background:transparent;border:none;}
QFrame {border:none;}
QMenuBar,QMenu,QToolBar,QStatusBar {background:#102329;color:#E5EEE9;border:1px solid #365C5A;}
QMenuBar::item {background:transparent;padding:5px 9px;}
QMenuBar::item:selected,QMenu::item:selected {background:#224C49;color:#66DFC0;}
QMenu::item {padding:6px 26px 6px 22px;}
QMenu::separator {height:1px;background:#365C5A;margin:4px 12px;}
QDockWidget {color:#E5EEE9;titlebar-close-icon:url(styles/df-assets/dark-wizard/icons/close.svg);}
QDockWidget::title {background:#102329;color:#66DFC0;padding:5px 9px;border-bottom:1px solid #365C5A;font-weight:600;}
QGroupBox {background:#102329;border:1px solid #365C5A;border-radius:8px;margin-top:12px;padding:12px 8px 8px;}
QGroupBox::title {subcontrol-origin:margin;subcontrol-position:top left;left:12px;padding:0px 5px;color:#66DFC0;background:#080F12;}
QPushButton,QToolButton {background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #193139,stop:1 #102329);border:1px solid #365C5A;border-radius:6px;color:#E5EEE9;padding:4px 8px;}
QPushButton:hover,QToolButton:hover {background:#224C49;border-color:#66DFC0;}
QPushButton:pressed,QToolButton:pressed,QPushButton:checked,QToolButton:checked {background:#29675E;border-color:#66DFC0;color:#E5EEE9;}
QPushButton:focus,QToolButton:focus {border:1px solid #66DFC0;background:#224C49;}
QPushButton:disabled,QToolButton:disabled {background:#080F12;color:#96B7B0;border-color:#102329;}
QPushButton#extract_button,QPushButton#download_video,QPushButton#video_upload {border-color:#66DFC0;font-weight:600;}
QLineEdit,QTextEdit,QPlainTextEdit,QSpinBox,QDoubleSpinBox,QComboBox {background:#080F12;color:#E5EEE9;border:1px solid #365C5A;border-radius:6px;padding:4px 6px;}
QLineEdit:focus,QTextEdit:focus,QPlainTextEdit:focus,QSpinBox:focus,QDoubleSpinBox:focus,QComboBox:focus {border-color:#66DFC0;}
QComboBox::drop-down {width:20px;border:none;}
QComboBox::down-arrow {image:url(styles/df-assets/dark-wizard/icons/chevron-down.svg);width:12px;height:12px;}
QSpinBox::up-arrow,QDoubleSpinBox::up-arrow {image:url(styles/df-assets/dark-wizard/icons/chevron-up.svg);width:9px;height:9px;}
QSpinBox::down-arrow,QDoubleSpinBox::down-arrow {image:url(styles/df-assets/dark-wizard/icons/chevron-down.svg);width:9px;height:9px;}
QComboBox QAbstractItemView {background:#102329;color:#E5EEE9;selection-background-color:#29675E;border:1px solid #66DFC0;}
QTabWidget::pane {border:1px solid #365C5A;background:#080F12;}
QTabBar::tab {background:#102329;color:#96B7B0;border:1px solid #365C5A;padding:6px 9px;margin-right:2px;}
QTabBar::tab:selected {background:#193139;color:#66DFC0;border-bottom:2px solid #66DFC0;}
QTabBar::tab:hover {background:#224C49;color:#E5EEE9;}
QTableView,QTreeView,QListView,QTableWidget,QTreeWidget,QListWidget {background:#080F12;alternate-background-color:#102329;color:#E5EEE9;border:1px solid #365C5A;gridline-color:#365C5A;selection-background-color:#29675E;selection-color:#E5EEE9;}
QAbstractItemView::item:hover {background:#224C49;}
QAbstractItemView::item:selected {background:#29675E;color:#E5EEE9;}
QHeaderView::section {background:#193139;color:#E5EEE9;padding:5px;border:none;border-bottom:1px solid #365C5A;font-weight:600;}
QTableCornerButton::section {background:#193139;border:1px solid #365C5A;}
QProgressBar {background:#080F12;border:1px solid #365C5A;border-radius:4px;text-align:center;color:#E5EEE9;min-height:12px;}
QProgressBar::chunk {background:#29675E;border-radius:3px;}
QSlider::groove:horizontal {background:#193139;height:6px;border-radius:3px;}
QSlider::sub-page:horizontal {background:#29675E;border-radius:3px;}
QSlider::handle:horizontal {background:#66DFC0;width:14px;margin:-4px 0;border-radius:7px;border:1px solid #C5AF76;}
QScrollBar:vertical {background:#080F12;width:10px;margin:0;}
QScrollBar:horizontal {background:#080F12;height:10px;margin:0;}
QScrollBar::handle {background:#365C5A;border-radius:4px;min-width:20px;min-height:20px;}
QScrollBar::handle:hover {background:#66DFC0;}
QScrollBar::add-line,QScrollBar::sub-line {height:0;width:0;}
QScrollBar::add-page,QScrollBar::sub-page {background:transparent;}
QCheckBox::indicator,QGroupBox::indicator {width:14px;height:14px;border:1px solid #365C5A;border-radius:3px;background:#080F12;}
QCheckBox::indicator:checked,QGroupBox::indicator:checked {background:#29675E;border-color:#66DFC0;image:url(styles/df-assets/dark-wizard/icons/check.svg);}
QCheckBox::indicator:hover {border-color:#66DFC0;}
QRadioButton::indicator {width:14px;height:14px;border:1px solid #365C5A;border-radius:7px;background:#080F12;}
QRadioButton::indicator:checked {border:4px solid #66DFC0;background:#080F12;}
QToolTip {background:#193139;color:#E5EEE9;border:1px solid #66DFC0;padding:5px;}
QSplitter::handle {background:#102329;}
QSplitter::handle:hover {background:#365C5A;}
QLabel#image_label_2 {background:#080F12;border:1px solid #365C5A;border-radius:8px;}
QCheckBox#zoom_lock,QCheckBox#image_quality_checkbox,QCheckBox#outline_Checkbox,QCheckBox#rapid_del_checkbox,QCheckBox#auto_scan_checkbox,QCheckBox#voice_mode_checkbox {padding:4px 8px;background:#193139;border:1px solid #365C5A;border-radius:6px;}
QCheckBox#zoom_lock:checked,QCheckBox#image_quality_checkbox:checked,QCheckBox#outline_Checkbox:checked,QCheckBox#rapid_del_checkbox:checked,QCheckBox#auto_scan_checkbox:checked,QCheckBox#voice_mode_checkbox:checked {background:#29675E;border-color:#66DFC0;}
QCheckBox#zoom_lock::indicator,QCheckBox#image_quality_checkbox::indicator,QCheckBox#outline_Checkbox::indicator,QCheckBox#rapid_del_checkbox::indicator,QCheckBox#auto_scan_checkbox::indicator,QCheckBox#voice_mode_checkbox::indicator {width:0;height:0;border:none;}
QWidget#dockWidgetContents_3,QFrame#frame_27 {background:transparent;}
QWidget[dfHeaderPanel="true"] {background:transparent;border:none;}
QPushButton#video_upload,QPushButton#download_video,QPushButton#remove_video_button {border:8px solid transparent;border-image:url(styles/df-assets/dark-wizard/buttons/background-normal.png) 16 16 16 16 stretch stretch;padding:0px 4px;}
QPushButton#video_upload:hover,QPushButton#download_video:hover,QPushButton#remove_video_button:hover {border-image:url(styles/df-assets/dark-wizard/buttons/background-hover.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:pressed,QPushButton#download_video:pressed,QPushButton#remove_video_button:pressed {border-image:url(styles/df-assets/dark-wizard/buttons/background-pressed.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:disabled,QPushButton#download_video:disabled,QPushButton#remove_video_button:disabled {border-image:url(styles/df-assets/dark-wizard/buttons/background-disabled.png) 16 16 16 16 stretch stretch;}
QPushButton#video_upload:focus,QPushButton#download_video:focus,QPushButton#remove_video_button:focus {border-image:url(styles/df-assets/dark-wizard/buttons/background-focus.png) 16 16 16 16 stretch stretch;}
/* FULL-WIDTH TOP BARS v2 */
QMenuBar {border-image:url(styles/df-assets/dark-wizard/menu-bar.png) 0 0 0 0 stretch stretch;border-bottom:1px solid #365C5A;}
QDockWidget::title {border-image:url(styles/df-assets/dark-wizard/status-bar.png) 0 0 0 0 stretch stretch;}
