/* Matrix: terminal green, but kept practical for long labeling sessions. */
QWidget {
    background-color: #0b0f0c;
    color: #d7ffe2;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    selection-background-color: #116b3a;
    selection-color: #ffffff;
}

QMainWindow,
QDialog {
    background-color: #070a08;
}

QLabel,
QCheckBox,
QRadioButton,
QGroupBox {
    background-color: transparent;
    color: #d7ffe2;
}

QMenuBar,
QMenu,
QToolBar,
QStatusBar,
QDockWidget {
    background-color: #0f1511;
    color: #d7ffe2;
    border-color: #1c2a20;
}

QMenuBar::item,
QMenu::item {
    padding: 5px 10px;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #116b3a;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #162019;
    padding: 5px;
    font-weight: 600;
}

QFrame,
QGroupBox {
    background-color: #0f1511;
    border: 1px solid #1c2a20;
    border-radius: 6px;
}

QGroupBox {
    margin-top: 12px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QPushButton,
QToolButton {
    background-color: #142119;
    color: #effff3;
    border: 1px solid #24432d;
    border-radius: 5px;
    padding: 5px 10px;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #193020;
    border-color: #22c55e;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #0d1811;
    border-color: #7ddc8a;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #101510;
    color: #6f8174;
    border-color: #1a241c;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: #050806;
    color: #effff3;
    border: 1px solid #24432d;
    border-radius: 5px;
    padding: 4px 6px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #22c55e;
}

QComboBox::drop-down {
    border-left: 1px solid #24432d;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #0b0f0c;
    color: #d7ffe2;
    border: 1px solid #24432d;
    selection-background-color: #116b3a;
}

QTabWidget::pane {
    border: 1px solid #1c2a20;
    background-color: #0b0f0c;
}

QTabBar::tab {
    background-color: #101a14;
    color: #bfe9ca;
    border: 1px solid #1c2a20;
    padding: 6px 10px;
    margin-right: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #173620;
    color: #ffffff;
    border-color: #28633b;
}

QTabBar::tab:!selected:hover {
    background-color: #16261b;
    color: #ffffff;
}

QTableView,
QTableWidget,
QTreeView,
QTreeWidget,
QListView,
QListWidget {
    background-color: #050806;
    alternate-background-color: #0d130f;
    color: #d7ffe2;
    border: 1px solid #1c2a20;
    gridline-color: #162019;
    selection-background-color: #116b3a;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #162019;
    color: #effff3;
    border: none;
    border-right: 1px solid #223126;
    border-bottom: 1px solid #223126;
    padding: 5px;
    font-weight: 600;
}

QProgressBar {
    background-color: #050806;
    color: #effff3;
    border: 1px solid #1c2a20;
    border-radius: 5px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #22c55e;
    border-radius: 4px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #1c2a20;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #22c55e;
    border: 1px solid #7ddc8a;
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background: #050806;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #24432d;
    border-radius: 6px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: #116b3a;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}
/* DarkFusion quick toggle buttons: compact inactive state, red active state. */
QCheckBox#zoom_lock,
QCheckBox#image_quality_checkbox,
QCheckBox#outline_Checkbox,
QCheckBox#rapid_del_checkbox,
QCheckBox#auto_scan_checkbox,
QCheckBox#voice_mode_checkbox {
    background-color: rgba(32, 36, 42, 190);
    color: #f2f5f8;
    border: 1px solid #3a424d;
    border-radius: 5px;
    padding: 4px 10px;
    spacing: 0;
}

QCheckBox#zoom_lock:hover,
QCheckBox#image_quality_checkbox:hover,
QCheckBox#outline_Checkbox:hover,
QCheckBox#rapid_del_checkbox:hover,
QCheckBox#auto_scan_checkbox:hover,
QCheckBox#voice_mode_checkbox:hover {
    background-color: rgba(45, 53, 64, 210);
    border-color: #ff7377;
}

QCheckBox#zoom_lock:checked,
QCheckBox#image_quality_checkbox:checked,
QCheckBox#outline_Checkbox:checked,
QCheckBox#rapid_del_checkbox:checked,
QCheckBox#auto_scan_checkbox:checked,
QCheckBox#voice_mode_checkbox:checked {
    background-color: #8f272b;
    color: #ffffff;
    border-color: #ff5a5f;
}

QCheckBox#zoom_lock:checked:hover,
QCheckBox#image_quality_checkbox:checked:hover,
QCheckBox#outline_Checkbox:checked:hover,
QCheckBox#rapid_del_checkbox:checked:hover,
QCheckBox#auto_scan_checkbox:checked:hover,
QCheckBox#voice_mode_checkbox:checked:hover {
    background-color: #a83236;
    border-color: #ff7377;
}

QCheckBox#zoom_lock::indicator,
QCheckBox#image_quality_checkbox::indicator,
QCheckBox#outline_Checkbox::indicator,
QCheckBox#rapid_del_checkbox::indicator,
QCheckBox#auto_scan_checkbox::indicator,
QCheckBox#voice_mode_checkbox::indicator {
    width: 0;
    height: 0;
    margin: 0;
}
